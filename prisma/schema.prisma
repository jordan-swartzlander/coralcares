// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VolunteerStatus {
  PENDING
  INVITED
  APPROVED
  DENIED

  @@map("volunteer_status")
}

enum CommitmentStatus {
  PENDING
  CONFIRMED
  CANCELLED

  @@map("commitment_status")
}

enum StaffRole {
  OWNER
  ADMINISTRATOR
  STAFF

  @@map("staff_role")
}

enum StaffStatus {
  PENDING_APPROVAL
  ACTIVE
  DENIED

  @@map("staff_status")
}

model Volunteer {
  id               Int              @id @default(autoincrement())
  name             String
  email            String           @unique
  phone            String?
  studentName      String?          @map("student_name")
  studentGrade     String?          @map("student_grade")
  studentTeacherId Int?             @map("student_teacher_id")
  passwordHash     String?          @map("password_hash")
  status           VolunteerStatus  @default(PENDING)
  totalHours       Float            @default(0) @map("total_hours")
  createdAt        DateTime         @default(now()) @map("created_at")
  approvedByStaffId Int?            @map("approved_by_staff_id")
  approvedAt       DateTime?        @map("approved_at")

  approvedBy       Staff?               @relation(fields: [approvedByStaffId], references: [id])
  studentTeacher   Teacher?             @relation(fields: [studentTeacherId], references: [id])
  commitments      Commitment[]
  strikes          Strike[]
  clearances       VolunteerClearance[]
  invites          VolunteerInvite[]

  @@map("volunteers")
}

// Managed by Owner/Administrator so classroom-specific opportunities and
// student records can reference a live, editable roster instead of free
// text — a teacher's assigned grade can change, or they can leave, without
// breaking historical references (deactivate rather than delete).
model Teacher {
  id        Int      @id @default(autoincrement())
  name      String
  grade     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  students      Volunteer[]
  opportunities Opportunity[]
  slots         Slot[]

  @@map("teachers")
}

model Staff {
  id           Int         @id @default(autoincrement())
  email        String      @unique
  passwordHash String      @map("password_hash")
  name         String
  role         StaffRole   @default(STAFF)
  status       StaffStatus @default(PENDING_APPROVAL)
  createdAt    DateTime    @default(now()) @map("created_at")

  approvedVolunteers  Volunteer[]
  approvedClearances  VolunteerClearance[]
  sentInvites         StaffInvite[]
  sentVolunteerInvites VolunteerInvite[]

  @@map("staff")
}

// Created by an Owner/Administrator to let someone self-complete a staff
// account (set name + password) via a one-time link. The Staff row itself
// isn't created until the invitee completes signup, and it starts out
// PENDING_APPROVAL — completing an invite does not grant access by itself.
model StaffInvite {
  id               Int       @id @default(autoincrement())
  email            String
  role             StaffRole
  token            String    @unique
  invitedByStaffId Int       @map("invited_by_staff_id")
  expiresAt        DateTime  @map("expires_at")
  usedAt           DateTime? @map("used_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  invitedBy Staff @relation(fields: [invitedByStaffId], references: [id])

  @@map("staff_invites")
}

// Created by an Owner/Administrator once a volunteer has been vetted
// (background check done externally). Unlike StaffInvite, the Volunteer row
// already exists from the public interest form, so this just ties a one-time
// signup token to that existing row. Completing it sets a password and moves
// status straight to APPROVED — no separate post-signup approval step, since
// vetting already happened before the invite was sent.
model VolunteerInvite {
  id               Int       @id @default(autoincrement())
  volunteerId      Int       @map("volunteer_id")
  token            String    @unique
  invitedByStaffId Int       @map("invited_by_staff_id")
  expiresAt        DateTime  @map("expires_at")
  usedAt           DateTime? @map("used_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  volunteer Volunteer @relation(fields: [volunteerId], references: [id])
  invitedBy Staff     @relation(fields: [invitedByStaffId], references: [id])

  @@map("volunteer_invites")
}

// One row per volunteer per school year. Absence of a row for the current
// school year means the volunteer has not been cleared this year (level 0) —
// starting a new school year is just switching AppSettings.currentSchoolYear,
// no data needs to change. Prior years' rows stay untouched as history.
model VolunteerClearance {
  id                Int       @id @default(autoincrement())
  volunteerId       Int       @map("volunteer_id")
  schoolYear        String    @map("school_year")
  level             Int       @default(0)
  approvedByStaffId Int?      @map("approved_by_staff_id")
  approvedAt        DateTime? @map("approved_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  volunteer  Volunteer @relation(fields: [volunteerId], references: [id])
  approvedBy Staff?    @relation(fields: [approvedByStaffId], references: [id])

  @@unique([volunteerId, schoolYear])
  @@map("volunteer_clearances")
}

// Singleton row (id is always 1) holding app-wide settings.
model AppSettings {
  id                Int    @id @default(1)
  currentSchoolYear String @map("current_school_year")

  @@map("app_settings")
}

enum OpportunityAudience {
  SCHOOL
  GRADE
  CLASSROOM

  @@map("opportunity_audience")
}

model Opportunity {
  id                Int                 @id @default(autoincrement())
  name              String
  description       String?
  requiredClearance Int                 @default(0) @map("required_clearance")
  active            Boolean             @default(true)
  audience          OpportunityAudience @default(SCHOOL)
  audienceGrade     String?             @map("audience_grade")
  audienceTeacherId Int?                @map("audience_teacher_id")

  audienceTeacher Teacher? @relation(fields: [audienceTeacherId], references: [id])
  slots           Slot[]

  @@map("opportunities")
}

// audienceOverride is null when the slot just inherits its parent
// Opportunity's audience. Set it (and the matching audienceGrade /
// audienceTeacherId) to target this specific slot differently — e.g. a
// school-wide "Fall Festival" opportunity where the 9am slot is
// Kindergarten-only and the 10am slot is Grade 1-only.
model Slot {
  id                Int                  @id @default(autoincrement())
  opportunityId     Int                  @map("opportunity_id")
  date              DateTime             @db.Date
  startTime         DateTime             @map("start_time") @db.Time()
  endTime           DateTime             @map("end_time") @db.Time()
  capacity          Int
  audienceOverride  OpportunityAudience? @map("audience_override")
  audienceGrade     String?              @map("audience_grade")
  audienceTeacherId Int?                 @map("audience_teacher_id")

  opportunity     Opportunity  @relation(fields: [opportunityId], references: [id])
  audienceTeacher Teacher?     @relation(fields: [audienceTeacherId], references: [id])
  commitments     Commitment[]

  @@map("slots")
}

model Commitment {
  id          Int              @id @default(autoincrement())
  volunteerId Int              @map("volunteer_id")
  slotId      Int              @map("slot_id")
  status      CommitmentStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")

  volunteer   Volunteer  @relation(fields: [volunteerId], references: [id])
  slot        Slot       @relation(fields: [slotId], references: [id])
  checkin     Checkin?
  strikes     Strike[]

  @@unique([volunteerId, slotId])
  @@map("commitments")
}

model Checkin {
  id            Int       @id @default(autoincrement())
  commitmentId  Int       @unique @map("commitment_id")
  checkInTime   DateTime? @map("check_in_time")
  checkOutTime  DateTime? @map("check_out_time")

  commitment    Commitment @relation(fields: [commitmentId], references: [id])

  @@map("checkins")
}

model Strike {
  id           Int         @id @default(autoincrement())
  volunteerId  Int         @map("volunteer_id")
  commitmentId Int?        @map("commitment_id")
  reason       String
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now()) @map("created_at")

  volunteer    Volunteer   @relation(fields: [volunteerId], references: [id])
  commitment   Commitment? @relation(fields: [commitmentId], references: [id])

  @@map("strikes")
}
